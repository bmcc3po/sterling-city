{
  "name": "sterling-city",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43180",
    "deploy": "npm run build && wrangler deploy",
    "pages": "npm run build && wrangler pages deploy dist --project-name=sterling-city --commit-dirty=true"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.133.0"
  }
}
